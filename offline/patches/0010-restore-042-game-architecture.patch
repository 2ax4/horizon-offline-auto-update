From 11d11dfb25eb7c98da17bd86a38da0476558d6f5 Mon Sep 17 00:00:00 2001
From: 2ax4 <2ax4@users.noreply.github.com>
Date: Wed, 11 Nov 2026 02:50:12 +0000
Subject: [PATCH 8/9] Restore the 0.2.42 game-architecture CLI setting and
 prune orphaned translations

---
 launcher/src/blocks_chrome.rs | 2 +-
 launcher/src/cli.rs           | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/launcher/src/blocks_chrome.rs b/launcher/src/blocks_chrome.rs
index 530901ff..f5dc246c 100644
--- a/launcher/src/blocks_chrome.rs
+++ b/launcher/src/blocks_chrome.rs
@@ -355,7 +355,7 @@ impl Launcher {
                 .id("launcher-version")
                 .px(px(8.))
                 .pt(px(6.))
-                .child(trf("Launcher {version}", &[("version", backend::VERSION)])),
+                .child(format!("Launcher {}", backend::VERSION)),
         );
         // Custom title bars carry the mark and name already.
         let brand = (!titlebar::draws_brand(window)).then(|| {
diff --git a/launcher/src/cli.rs b/launcher/src/cli.rs
index b445ee45..c6405cd6 100644
--- a/launcher/src/cli.rs
+++ b/launcher/src/cli.rs
@@ -1395,7 +1395,7 @@ fn execute(command: Cmd, as_json: bool) -> Result<i32, String> {
                     // The instance's version is never looked at here: the newest installed
                     // release or Nightly, or that one with `--update` (never a native build).
                     None => native_mods::base_for(None, &backend::installed(), update)
-                        .ok_or_else(backend::no_version_installed)?,
+                        .ok_or_else(|| tr("No version is installed yet."))?,
                 };
                 let built = native_mods::build_server(
                     &base,
@@ -1436,7 +1436,7 @@ fn execute(command: Cmd, as_json: bool) -> Result<i32, String> {
                 None => {
                     let plays = target.resolve_version(None).ok();
                     native_mods::base_for(plays.as_deref(), &backend::installed(), update)
-                        .ok_or_else(backend::no_version_installed)?
+                        .ok_or("No version is installed yet.")?
                 }
             };
             let explicit = folder.is_some() || profile.is_some();
-- 
2.47.3

