diff --git a/launcher/src/skin_page.rs b/launcher/src/skin_page.rs
new file mode 100644
index 000000000..d4bcb8a9e
--- /dev/null
+++ b/launcher/src/skin_page.rs
@@ -0,0 +1,264 @@
+//! Settings > Account's skin panel for an offline name (`horizon_launcher::skins`): the front
+//! of the skin and the cape, choosing either from a PNG, and the model.
+use super::*;
+use gpui::RenderImage;
+use horizon_launcher::skins::{self, Model};
+use std::path::PathBuf;
+use std::sync::Arc;
+
+/// A baked preview, or None without one.
+type Preview = Option<Arc<RenderImage>>;
+
+#[derive(Default)]
+pub(super) struct SkinPanel {
+    /// The offline name it is for.
+    pub(super) name: String,
+    /// The two previews, baked at the window's scale (skin, cape), or None without one.
+    seen: Option<(f32, Preview, Preview)>,
+    /// What the last choice did, or why not.
+    note: Option<Result<String, String>>,
+}
+
+/// Points per skin texel in the preview.
+const TEXEL: f32 = 6.;
+
+impl Launcher {
+    pub(super) fn open_skin(&mut self, name: String) {
+        self.skin = match self.skin.take() {
+            Some(p) if p.name == name => None,
+            _ => Some(SkinPanel {
+                name,
+                ..SkinPanel::default()
+            }),
+        };
+    }
+
+    fn save_look(&mut self, change: impl FnOnce(&mut skins::Look)) -> Result<(), String> {
+        let Some(name) = self.skin.as_ref().map(|p| p.name.clone()) else {
+            return Ok(());
+        };
+        let mut accounts = Accounts::load();
+        // The name may have been forgotten while a file dialog was open: keep nothing for it.
+        if !accounts
+            .offline
+            .iter()
+            .any(|n| n.eq_ignore_ascii_case(&name))
+        {
+            return Ok(());
+        }
+        let mut look = accounts.look(&name);
+        change(&mut look);
+        accounts.looks.insert(name.to_ascii_lowercase(), look);
+        accounts.save()?;
+        self.accounts = accounts;
+        if let Some(p) = &mut self.skin {
+            p.seen = None;
+        }
+        Ok(())
+    }
+
+    fn choose_look_file(&mut self, cape: bool, cx: &mut Context<Self>) {
+        let paths = cx.prompt_for_paths(PathPromptOptions {
+            files: true,
+            directories: false,
+            multiple: false,
+            prompt: Some(tr("Choose").into()),
+        });
+        cx.spawn(async move |this, cx| {
+            let Ok(Ok(Some(mut paths))) = paths.await else {
+                return;
+            };
+            let Some(path) = paths.pop() else {
+                return;
+            };
+            let _ = this.update(cx, |this, cx| {
+                this.take_look_file(path, cape);
+                cx.notify();
+            });
+        })
+        .detach();
+    }
+
+    pub(super) fn take_look_file(&mut self, path: PathBuf, cape: bool) {
+        let Some(name) = self.skin.as_ref().map(|p| p.name.clone()) else {
+            return;
+        };
+        // The name may have been forgotten while the file dialog was open.
+        if !Accounts::load()
+            .offline
+            .iter()
+            .any(|n| n.eq_ignore_ascii_case(&name))
+        {
+            return;
+        }
+        let done = skins::keep(&skins::dir(), &name, &path, cape).and_then(|()| {
+            self.save_look(|l| match cape {
+                false => l.skin = true,
+                true => l.cape = true,
+            })
+        });
+        if let Some(p) = &mut self.skin {
+            let said = match cape {
+                false => trf("{name}'s skin is kept.", &[("name", &name)]),
+                true => trf("{name}'s cape is kept.", &[("name", &name)]),
+            };
+            p.note = Some(done.map(|()| said));
+        }
+    }
+
+    fn previews(&mut self) -> (Preview, Preview) {
+        let scale = self.scale;
+        let Some(panel) = &mut self.skin else {
+            return (None, None);
+        };
+        if let Some((s, skin, cape)) = &panel.seen {
+            if *s == scale {
+                return (skin.clone(), cape.clone());
+            }
+        }
+        let look = self.accounts.look(&panel.name);
+        let (skin_file, cape_file) = skins::files(&skins::dir(), &panel.name);
+        let read = |f: &PathBuf| std::fs::read(f).ok();
+        let skin = read(&skin_file)
+            .filter(|_| look.skin)
+            .and_then(|b| skins::read_skin(&b).ok())
+            .map(|png| art::bake(&skins::front(&png, look.model), 16, 32, TEXEL, scale));
+        let cape = read(&cape_file)
+            .filter(|_| look.cape)
+            .and_then(|b| skins::read_cape(&b).ok())
+            .map(|png| art::bake(&skins::cape_front(&png), 10, 16, TEXEL, scale));
+        panel.seen = Some((scale, skin.clone(), cape.clone()));
+        (skin, cape)
+    }
+
+    /// The panel, under the offline names while open.
+    pub(super) fn skin_panel(&mut self, cx: &mut Context<Self>) -> Option<Div> {
+        let t = self.theme;
+        let name = self.skin.as_ref()?.name.clone();
+        if !self.accounts.offline.iter().any(|n| n == &name) {
+            self.skin = None;
+            return None;
+        }
+        let look = self.accounts.look(&name);
+        let (skin, cape) = self.previews();
+        let frame = |w: f32, h: f32, image: Preview, empty: &'static str| {
+            div()
+                .flex()
+                .flex_none()
+                .items_center()
+                .justify_center()
+                .w(px(w + 24.))
+                .h(px(h + 24.))
+                .bg(t.well)
+                .border_2()
+                .border_color(t.outline)
+                .child(match image {
+                    Some(i) => gpui::img(i).w(px(w)).h(px(h)).into_any_element(),
+                    None => text(theme::CAPTION)
+                        .text_color(t.muted)
+                        .child(tr(empty))
+                        .into_any_element(),
+                })
+        };
+        let weak = cx.entity().downgrade();
+        let model = segments(
+            "skin-model",
+            &[(Model::Classic, "Classic arms"), (Model::Slim, "Slim arms")],
+            look.model,
+            &t,
+            move |m, _, cx| {
+                let _ = weak.update(cx, |this, cx| {
+                    let _ = this.save_look(|l| l.model = m);
+                    cx.notify();
+                });
+            },
+        );
+        let pick = |id: &'static str, label: &'static str, cape: bool, cx: &mut Context<Self>| {
+            button(id, label, Kind::Secondary, &t).on_click(cx.listener(
+                move |this, _: &ClickEvent, _, cx| {
+                    this.choose_look_file(cape, cx);
+                    cx.notify();
+                },
+            ))
+        };
+        let drop = |id: &'static str, label: &'static str, cape: bool, cx: &mut Context<Self>| {
+            button(id, label, Kind::Ghost, &t).on_click(cx.listener(
+                move |this, _: &ClickEvent, _, cx| {
+                    let _ = this.save_look(|l| match cape {
+                        false => l.skin = false,
+                        true => l.cape = false,
+                    });
+                    cx.notify();
+                },
+            ))
+        };
+        let mut skin_buttons = div().flex().flex_wrap().gap(px(6.)).child(pick(
+            "skin-choose",
+            "Choose a skin…",
+            false,
+            cx,
+        ));
+        if look.skin {
+            skin_buttons = skin_buttons.child(drop("skin-remove", "Default skin", false, cx));
+        }
+        let mut cape_buttons = div().flex().flex_wrap().gap(px(6.)).child(pick(
+            "cape-choose",
+            "Choose a cape…",
+            true,
+            cx,
+        ));
+        if look.cape {
+            cape_buttons = cape_buttons.child(drop("cape-remove", "No cape", true, cx));
+        }
+        let note = self.skin.as_ref().and_then(|p| p.note.clone());
+        Some(
+            plate(&t)
+                .flex()
+                .flex_col()
+                .gap(px(12.))
+                .px(px(16.))
+                .py(px(12.))
+                .when(!t.glass, |d| d.ml(px(40.)))
+                .child(
+                    div()
+                        .flex()
+                        .gap(px(16.))
+                        .child(frame(16. * TEXEL, 32. * TEXEL, skin, "Default"))
+                        .child(frame(10. * TEXEL, 16. * TEXEL, cape, "No cape"))
+                        .child(
+                            div()
+                                .flex()
+                                .flex_col()
+                                .items_start()
+                                .flex_1()
+                                .min_w_0()
+                                .gap(px(10.))
+                                .child(
+                                    caps(trf("{name}'s skin", &[("name", &name)]))
+                                        .text_color(t.muted),
+                                )
+                                .child(skin_buttons)
+                                .child(model)
+                                .child(cape_buttons)
+                                .children(note.map(|n| match n {
+                                    Ok(said) => {
+                                        text(theme::CAPTION).text_color(t.muted).child(said)
+                                    }
+                                    Err(e) => text(theme::CAPTION).text_color(t.danger).child(e),
+                                })),
+                        ),
+                )
+                .child(
+                    text(theme::CAPTION)
+                        .text_color(t.muted)
+                        .line_height(px(16.))
+                        .child(tr(
+                            "A 64×64 (or 64×32) skin PNG and a 64×32 cape PNG, kept by the \
+                     launcher and given to the game when this name plays. The game \
+                     draws the default skins for now; it uses these once it can. A \
+                     Microsoft account's skin and cape: coming soon.",
+                        )),
+                ),
+        )
+    }
+}
diff --git a/launcher/src/skins.rs b/launcher/src/skins.rs
new file mode 100644
index 000000000..a70933aa8
--- /dev/null
+++ b/launcher/src/skins.rs
@@ -0,0 +1,183 @@
+//! Offline skins and capes: a PNG the player picks for an offline name, kept in the launcher's
+//! `skins/` folder, with its model (classic arms or slim). The game gets them in
+//! `HORIZON_OFFLINE_SKIN`, `HORIZON_OFFLINE_SKIN_MODEL` and `HORIZON_OFFLINE_CAPE` when that
+//! name plays, and draws them on the local player (`skins::offline_skin`, `skins::offline_cape`).
+//!
+//! Skins are the layout every Java Edition skin uses: 64×64, or the older 64×32 (whose left arm
+//! and leg are the right ones mirrored). Capes are 64×32 (or the older 22×17).
+use serde::{Deserialize, Serialize};
+use std::path::{Path, PathBuf};
+
+pub const SKIN_ENV: &str = "HORIZON_OFFLINE_SKIN";
+pub const MODEL_ENV: &str = "HORIZON_OFFLINE_SKIN_MODEL";
+pub const CAPE_ENV: &str = "HORIZON_OFFLINE_CAPE";
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Model {
+    /// Four-pixel arms ("Steve").
+    #[default]
+    Classic,
+    /// Three-pixel arms ("Alex").
+    Slim,
+}
+
+impl Model {
+    pub fn name(self) -> &'static str {
+        match self {
+            Model::Classic => "classic",
+            Model::Slim => "slim",
+        }
+    }
+}
+
+/// What an offline name wears.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Look {
+    #[serde(default)]
+    pub model: Model,
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub skin: bool,
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub cape: bool,
+}
+
+/// Where an offline name's files are: `skins/<name>.png` and `skins/<name>.cape.png`, the name
+/// in lowercase (offline names are kept once in any case).
+pub fn files(dir: &Path, name: &str) -> (PathBuf, PathBuf) {
+    let key = name.to_ascii_lowercase();
+    (
+        dir.join(format!("{key}.png")),
+        dir.join(format!("{key}.cape.png")),
+    )
+}
+
+pub fn dir() -> PathBuf {
+    crate::backend::data_dir().join("skins")
+}
+
+fn decode(bytes: &[u8]) -> Result<image::RgbaImage, String> {
+    image::load_from_memory_with_format(bytes, image::ImageFormat::Png)
+        .map(|i| i.to_rgba8())
+        .map_err(|_| "That isn't a PNG picture.".to_string())
+}
+
+/// A skin's picture, if it is one: 64×64 or 64×32.
+pub fn read_skin(bytes: &[u8]) -> Result<image::RgbaImage, String> {
+    let png = decode(bytes)?;
+    match png.dimensions() {
+        (64, 64) | (64, 32) => Ok(png),
+        (w, h) => Err(format!(
+            "A skin is 64×64 (or the older 64×32) pixels; this one is {w}×{h}."
+        )),
+    }
+}
+
+/// A cape's picture, if it is one: 64×32 or 22×17.
+pub fn read_cape(bytes: &[u8]) -> Result<image::RgbaImage, String> {
+    let png = decode(bytes)?;
+    match png.dimensions() {
+        (64, 32) | (22, 17) => Ok(png),
+        (w, h) => Err(format!(
+            "A cape is 64×32 (or the older 22×17) pixels; this one is {w}×{h}."
+        )),
+    }
+}
+
+/// A part of the skin copied to the front view: from (x, y), its size, to (x, y), mirrored.
+type Part = (u32, u32, u32, u32, u32, u32, bool);
+
+/// The front of the player, 16×32 texels: head, body, arms and legs, each with its outer layer
+/// over it (64×64 skins have one for every part; 64×32 only for the head).
+pub fn front(skin: &image::RgbaImage, model: Model) -> Vec<[u8; 4]> {
+    let w = 16usize;
+    let mut out = vec![[0u8; 4]; w * 32];
+    let modern = skin.height() == 64;
+    let arm = if model == Model::Slim { 3 } else { 4 };
+    let mut base: Vec<Part> = vec![
+        (8, 8, 8, 8, 4, 0, false),            // head
+        (20, 20, 8, 12, 4, 8, false),         // body
+        (44, 20, arm, 12, 4 - arm, 8, false), // right arm, on the viewer's left
+        (4, 20, 4, 12, 4, 20, false),         // right leg
+    ];
+    let mut outer: Vec<Part> = vec![(40, 8, 8, 8, 4, 0, false)];
+    if modern {
+        base.extend([
+            (36, 52, arm, 12, 12, 8, false),
+            (20, 52, 4, 12, 8, 20, false),
+        ]);
+        outer.extend([
+            (20, 36, 8, 12, 4, 8, false),
+            (44, 36, arm, 12, 4 - arm, 8, false),
+            (52, 52, arm, 12, 12, 8, false),
+            (4, 36, 4, 12, 4, 20, false),
+            (4, 52, 4, 12, 8, 20, false),
+        ]);
+    } else {
+        base.extend([(44, 20, arm, 12, 12, 8, true), (4, 20, 4, 12, 8, 20, true)]);
+    }
+    for (layer, parts) in [base, outer].into_iter().enumerate() {
+        for (fx, fy, pw, ph, tx, ty, mirrored) in parts {
+            for dy in 0..ph {
+                for dx in 0..pw {
+                    let sx = if mirrored { fx + pw - 1 - dx } else { fx + dx };
+                    let c = skin.get_pixel(sx, fy + dy).0;
+                    // The base layer is opaque in game; the outer one shows where it is drawn.
+                    if layer == 0 || c[3] > 0 {
+                        out[(ty + dy) as usize * w + (tx + dx) as usize] = [c[0], c[1], c[2], 255];
+                    }
+                }
+            }
+        }
+    }
+    out
+}
+
+/// The cape's outside, 10×16 texels.
+pub fn cape_front(cape: &image::RgbaImage) -> Vec<[u8; 4]> {
+    let mut out = Vec::with_capacity(160);
+    for y in 1..17 {
+        for x in 1..11 {
+            out.push(cape.get_pixel(x, y).0);
+        }
+    }
+    out
+}
+
+/// Keeps `file` as `name`'s skin (or cape), checked first.
+pub fn keep(dir: &Path, name: &str, file: &Path, cape: bool) -> Result<(), String> {
+    let bytes = std::fs::read(file).map_err(|e| format!("{}: {e}", file.display()))?;
+    match cape {
+        false => read_skin(&bytes).map(|_| ())?,
+        true => read_cape(&bytes).map(|_| ())?,
+    }
+    std::fs::create_dir_all(dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+    let (skin, cape_file) = files(dir, name);
+    let to = if cape { cape_file } else { skin };
+    std::fs::write(&to, bytes).map_err(|e| format!("{}: {e}", to.display()))
+}
+
+/// Drops a forgotten name's files (`Accounts::remove_offline`); missing files are fine.
+pub fn forget(dir: &Path, name: &str) {
+    let (skin, cape) = files(dir, name);
+    let _ = std::fs::remove_file(skin);
+    let _ = std::fs::remove_file(cape);
+}
+
+/// The variables the game gets for `name`'s look.
+pub fn env(dir: &Path, name: &str, look: &Look) -> Vec<(&'static str, String)> {
+    let (skin, cape) = files(dir, name);
+    let mut out = Vec::new();
+    if look.skin && skin.is_file() {
+        out.push((SKIN_ENV, skin.to_string_lossy().into_owned()));
+        out.push((MODEL_ENV, look.model.name().to_string()));
+    }
+    if look.cape && cape.is_file() {
+        out.push((CAPE_ENV, cape.to_string_lossy().into_owned()));
+    }
+    out
+}
